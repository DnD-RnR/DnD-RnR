{
  "name": "dnd-rnr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "server:dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "admin:create": "node --env-file-if-exists=.env server/create-admin.mjs",
    "test": "node --test server/auth.test.mjs server/spellcasting.test.mjs server/character-traits.test.mjs server/game-sessions.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
