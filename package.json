{
  "name": "dnd-rnr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "server:dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "admin:create": "node --env-file-if-exists=.env server/create-admin.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-firestore.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/check-firestore.mjs",
    "db:rules": "node --env-file-if-exists=.env scripts/firestore-rules.mjs",
    "test": "node --test server/advancement.test.mjs server/paladin.test.mjs server/druid.test.mjs server/origin-feats.test.mjs server/warlock.test.mjs server/auth.test.mjs server/spellcasting.test.mjs server/character-traits.test.mjs server/game-sessions.test.mjs server/monsters.test.mjs server/battles.test.mjs server/combat-spells.test.mjs server/weapons.test.mjs server/armors.test.mjs server/firestore.test.mjs server/live-sync.test.mjs",
    "perf:firestore": "node --test --test-name-pattern=\"cost benchmark\" server/firestore.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:seed-origin-feats": "node --env-file-if-exists=.env scripts/seed-origin-feats.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "firebase-admin": "^14.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
